<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-statement-table" author="Ivan">
        <createTable tableName="statement">
            <column name="statement_id" type="uuid">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>

            <column name="client_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_statement_client"
                             references="client(client_id)"/>
            </column>

            <column name="credit_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_statement_credit"
                             references="credit(credit_id)"/>
            </column>

            <column name="status" type="varchar(255)"/>
            <column name="creation_date" type="timestamp"/>
            <column name="applied_offer" type="jsonb"/>
            <column name="sign_date" type="timestamp"/>
            <column name="ses_code" type="varchar(255)"/>
            <column name="status_history" type="jsonb"/>
        </createTable>
    </changeSet>


</databaseChangeLog>
